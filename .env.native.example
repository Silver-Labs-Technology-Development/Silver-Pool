# Silver Pool native deployment configuration (BTCS mainnet).
#
# Copy this file to .env.native in the repository root, replace every
# placeholder, and run:
#   chmod 600 .env.native
#
# .env.native is ignored by Git. Never commit real RPC credentials, wallet
# material, stratum passwords or a populated environment file.
#
# Payouts are intentionally disabled. BTCS_AUTO_PAYOUTS must remain false:
# this release has no signing, operator authorization, confirmation policy,
# duplicate-payment protection or recovery procedure for payouts.

# ---------------------------------------------------------------------------
# BTCS node (existing synced service, never exposed publicly)
# ---------------------------------------------------------------------------
BTCS_NETWORK=main
BTCS_RPC_URL=http://127.0.0.1:10567
BTCS_RPC_USER=replace-with-node-rpc-user
BTCS_RPC_PASSWORD=replace-with-the-node-rpc-password
BTCS_RPC_WALLET=pool
BTCS_RPC_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Coinbase and accounting
# ---------------------------------------------------------------------------
# Set exactly one of these. The address is the pool's block-reward address;
# it must be valid on BTCS mainnet. The pool never sends a payout.
BTCS_POOL_ADDRESS=
BTCS_POOL_SCRIPT_PUBKEY=

BTCS_POOL_FEE=2.0
BTCS_MIN_PAYOUT=0.01
BTCS_PAYOUT_INTERVAL_SECONDS=300
BTCS_AUTO_PAYOUTS=false
BTCS_MATURITY_CONFIRMATIONS=200

# ---------------------------------------------------------------------------
# Stratum V1
# ---------------------------------------------------------------------------
# Bind 0.0.0.0 only after you have a firewall/port-forward decision. Loopback
# is the safe default. Public miners require an externally reachable TCP path;
# a Cloudflare HTTP Worker cannot proxy raw Stratum TCP.
BTCS_STRATUM_HOST=127.0.0.1
BTCS_STRATUM_PORT=3333
BTCS_STRATUM_PASSWORD=replace-with-a-long-random-stratum-password

# Only advertise an endpoint after an external TCP test succeeds. Leaving this
# blank makes the API/site report "Not configured" instead of inventing one.
BTCS_PUBLIC_STRATUM_HOST=
BTCS_PUBLIC_STRATUM_PORT=3333

# Static per-session difficulty. There is no vardiff.
BTCS_POOL_DIFFICULTY=1.0
BTCS_EXTRANONCE2_SIZE=4
BTCS_POOL_POLL=5
BTCS_MAX_CLIENTS=500
BTCS_CLIENT_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------------------
# HTTP API and static site
# ---------------------------------------------------------------------------
# Keep the API on loopback. The local website process proxies /api to it.
BTCS_POOL_API_HOST=127.0.0.1
BTCS_POOL_API_PORT=8765
BTCS_API_CORS_ORIGINS=http://127.0.0.1:8080
BTCS_API_RATE_LIMIT_PER_MINUTE=240
BTCS_TRUSTED_PROXIES=127.0.0.1/32
BTCS_LOG_LEVEL=INFO

# Runtime database. The parent directory is created by install.sh.
BTCS_POOL_DB=data/mainnet/pool.sqlite3

# Local website bind. Use 0.0.0.0 only on a trusted LAN or behind a TLS proxy.
SILVER_POOL_HTTP_BIND=127.0.0.1
SILVER_POOL_HTTP_PORT=8080

# Public DNS name for a TLS-terminating reverse proxy. Not used by the native
# loopback services; leave blank until a real endpoint exists.
SILVER_POOL_SITE_ADDRESS=

SILVER_POOL_VERSION=0.2.0
