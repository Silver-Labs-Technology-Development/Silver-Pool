# Silver Pool deployment configuration.
#
# Copy this file to .env, replace every placeholder, and keep the result out of
# Git. `docker compose` reads .env automatically when run from the repository
# root. RPC credentials, wallet material and node datadirs are never committed.
#
# Payouts are intentionally disabled. BTCS_AUTO_PAYOUTS must stay false until
# reward signing, confirmations, recovery and payment tests are complete.

# ---------------------------------------------------------------------------
# BTCS network and node
# ---------------------------------------------------------------------------
# main, test, testnet4, signet or regtest
BTCS_NETWORK=main

# Internal Compose address. RPC is never published to the host.
# For main use http://node:10567 and port 10567 / P2P 10566.
# For regtest use http://node:18443 and port 18443 / P2P 18444, and set
# BTCS_RPC_URL accordingly. Testnet/testnet4/signet use their own ports.
BTCS_RPC_URL=http://node:10567
BTCS_RPC_PORT=10567
BTCS_P2P_PORT=10566

# Use a long random password. The node writes it to /data/bitcoin.conf with
# mode 0600 inside the private node volume.
BTCS_RPC_USER=silver-pool-rpc
BTCS_RPC_PASSWORD=replace-with-a-long-random-rpc-password

# Wallet used only to derive the coinbase address when neither
# BTCS_POOL_ADDRESS nor BTCS_POOL_SCRIPT_PUBKEY is supplied. The pool creates
# and loads it on first start through the node RPC.
BTCS_RPC_WALLET=pool

# Restrict RPC to the private Docker network. Do not change this to 0.0.0.0
# and never publish port 10567.
BTCS_RPC_ALLOW_CIDR=172.16.0.0/12
BTCS_NODE_MAX_CONNECTIONS=64
BTCS_NODE_DBCACHE_MB=300

# ---------------------------------------------------------------------------
# Pool coinbase and accounting
# ---------------------------------------------------------------------------
# Set a public BTCS address OR a raw scriptPubKey. Leave both blank to let the
# wallet create an address (requires BTCS_RPC_WALLET).
BTCS_POOL_ADDRESS=
BTCS_POOL_SCRIPT_PUBKEY=
BTCS_POOL_FEE=2.0
BTCS_MIN_PAYOUT=0.01
BTCS_PAYOUT_INTERVAL_SECONDS=300
BTCS_AUTO_PAYOUTS=false
BTCS_MATURITY_CONFIRMATIONS=200

# ---------------------------------------------------------------------------
# Stratum
# ---------------------------------------------------------------------------
BTCS_STRATUM_PORT=3333

# Only advertise an endpoint that actually resolves and accepts TCP traffic.
# Leave blank and every page will show "Not configured" instead of inventing
# an address.
BTCS_PUBLIC_STRATUM_HOST=
BTCS_STRATUM_PASSWORD=
BTCS_POOL_DIFFICULTY=1.0
BTCS_EXTRANONCE2_SIZE=4
BTCS_POOL_POLL=5
BTCS_MAX_CLIENTS=500
BTCS_CLIENT_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------------------
# HTTP API and website
# ---------------------------------------------------------------------------
BTCS_API_CORS_ORIGINS=http://127.0.0.1:8080
BTCS_API_RATE_LIMIT_PER_MINUTE=240
# Base URL for API calls from the website (used by Vite build).
# Local development: http://127.0.0.1:8765 (backend running on loopback)
# Production: point to the deployed API endpoint (e.g. https://pool.your-domain.com).
VITE_API_BASE_URL=http://127.0.0.1:8765
# Caddy is the only trusted proxy in the default stack. Forwarded client IPs
# are used for rate limiting only when the direct peer matches this CIDR.
BTCS_TRUSTED_PROXIES=172.16.0.0/12
BTCS_LOG_LEVEL=INFO

# Base path for the static build. Use /Silver-Pool/ only when hosting the site
# under a GitHub Pages repository subpath.
SITE_BASE=/

# Bind the local web port to loopback by default. Put a TLS terminator in front,
# or use deploy/docker-compose.prod.yml with SILVER_POOL_SITE_ADDRESS below.
SILVER_POOL_HTTP_BIND=127.0.0.1
SILVER_POOL_HTTP_PORT=8080

# For the production overlay only: a public DNS name pointing at this host.
# Caddy will obtain a certificate automatically.
SILVER_POOL_SITE_ADDRESS=

# ---------------------------------------------------------------------------
# Pinned BTCS Core release (official binaries)
# ---------------------------------------------------------------------------
BTCS_VERSION=31.1.3
BTCS_RELEASE_URL=https://github.com/bitcoin-silver/core/releases/download/version31.1.3/bitcoinsilver-31.1.3-x86_64-linux-gnu.tar.gz
BTCS_RELEASE_SHA256=6743ecef53501687574a5f761ddb41dcce960953e0e0b6ef362ab69268767c4c
SILVER_POOL_VERSION=0.2.0
